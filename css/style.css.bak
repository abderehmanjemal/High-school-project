body{
	background-image: url("img_6.jpg");
	background-size: cover;
	background-attachment: fixed;
	color: black;
}
  
ul{
  margin: 0px;
  padding: 0px;
  list-style-type: none;
}


ul li{
     float: left;
     width: 200px;
     height: 40px;
     background-color: black;
     line-height: 40px;
     text-align: center;
     font-size: 20px;
     opacity: .8;
	 
}


ul li a{
	text-decoration:none;
	color: white;
	display: block;
	transition: 2s background-color ease 0s;
}


ul li a:hover{
	background-color: green;	

}


ul li ul li{
	display: none;
	
}


ul li:hover ul li{
	display: block;
}